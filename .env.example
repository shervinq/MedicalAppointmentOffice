# توکن بازو از BotFather بله
BALE__TOKEN=replace-me

# توکن کیف پول؛ برای تست می‌توانید مقدار زیر را نگه دارید
BALE__PAYMENTPROVIDERTOKEN=WALLET-TEST-1111111111111111

# آدرس HTTPS عمومی سرویس، بدون اسلش انتهایی
BALE__PUBLICBASEURL=https://bot.example.com

# یک رشته تصادفی طولانی که در URL وب‌هوک استفاده می‌شود
BALE__WEBHOOKSECRET=replace-with-at-least-32-random-characters

# شناسه عددی بله ادمین؛ چند شناسه را با کاما جدا کنید
BALE__ADMINUSERIDS__0=123456789

CONNECTIONSTRINGS__DEFAULT=Data Source=/app/data/appointments.db
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
